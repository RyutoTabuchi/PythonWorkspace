{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Workspace: 新規プロジェクトを作成",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}\\.tools\\NewProject\\New-Project.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Workspace: 許可パッケージを管理",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}\\.tools\\ApprovedPackages\\Manage-ApprovedPackage.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Workspace: 許可パッケージ資料を再生成",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}\\.tools\\ApprovedPackages\\Update-ApprovedPackagesDocument.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Project: 実行用パッケージを導入",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}\\.tools\\ApprovedPackages\\Install-Packages.ps1",
                "-SelectProject",
                "-Target", "Runtime"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Project: 開発用パッケージを導入",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}\\.tools\\ApprovedPackages\\Install-Packages.ps1",
                "-SelectProject",
                "-Target", "Development"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        },
        {
            "label": "Project: すべてのパッケージを導入",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}\\.tools\\ApprovedPackages\\Install-Packages.ps1",
                "-SelectProject",
                "-Target", "All"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true },
            "problemMatcher": []
        }
    ]
}